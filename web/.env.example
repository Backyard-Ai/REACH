# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Anon (publishable) key — RLS gates every read; safe for server use,
# never bundled into client code (all queries run server-side).
SUPABASE_ANON_KEY=

# Service-role key — scripts/seed.ts and the /api/submissions route ONLY.
# Never in client code, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret for the public submissions route. Optional:
# when absent the route logs and skips verification (local dev).
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key — public by design, inlined into the
# client bundle at BUILD time (add to Vercel, then redeploy). Absent =
# no widget in the correction form, matching the server-side skip.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Salt for hashing submitter IPs (rate limiting). Optional but recommended
# in production; rotating it invalidates existing hashes.
IP_HASH_SALT=

# Shared secret for the one-click submission accept endpoint
# (Directus reviewers visit /api/admin/accept/[id]?token=ADMIN_ACTION_TOKEN)
ADMIN_ACTION_TOKEN=
