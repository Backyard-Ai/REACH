# Directus local instance — copy to .env.directus and fill in.
# Generate:  DIRECTUS_KEY/SECRET = openssl rand -hex 32 (two different runs)
#            DIRECTUS_DB_PASSWORD = the password set in web/sql/004_directus_role.sql
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_DB_PASSWORD=
# The license key from the Open Innovation grant email (as text, not
# transcribed from the screenshot).
DIRECTUS_LICENSE_KEY=
